{
  "name": "miraiplayer",
  "private": true,
  "version": "0.1.7",
  "description": "支持在线曲库、同步歌词和桌面小窗的玻璃风格音乐播放器",
  "author": "XiangZi",
  "homepage": "https://github.com/XiangZi7/MiraiPlayer",
  "repository": "github:XiangZi7/MiraiPlayer",
  "bugs": "https://github.com/XiangZi7/MiraiPlayer/issues",
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "release": "node scripts/release.mjs",
    "version:set": "node scripts/release-version.mjs",
    "version:check": "node scripts/release-version.mjs --check",
    "check:release": "node scripts/check-release.mjs",
    "release:build": "node scripts/check-release.mjs && node scripts/release-build.mjs && node scripts/package-release.mjs",
    "format": "prettier --write \"src/**/*.{vue,ts,js,jsx,html,css,scss,md}\""
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@iconify/vue": "^5.0.5",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-updater": "~2.14.1",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.21.1",
    "pinia": "^4.1.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "three": "^0.187.0",
    "uqr": "^0.1.3",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.22",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.6",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  }
}
