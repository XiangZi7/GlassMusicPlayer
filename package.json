{
  "name": "miraiplayer",
  "private": true,
  "version": "0.1.0",
  "description": "支持在线曲库、同步歌词和桌面小窗的玻璃风格音乐播放器",
  "author": "XiangZi",
  "homepage": "https://github.com/XiangZi7/MiraiPlayer",
  "repository": "github:XiangZi7/MiraiPlayer",
  "bugs": "https://github.com/XiangZi7/MiraiPlayer/issues",
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && node scripts/check-built-css.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "check:release": "node scripts/check-release.mjs",
    "release:build": "node scripts/check-release.mjs && tauri build -- --locked && node scripts/package-release.mjs",
    "format": "prettier --write \"src/**/*.{vue,ts,js,jsx,html,css,scss,md}\"",
    "check:motion": "node scripts/check-motion.mjs",
    "check:fullscreen": "node scripts/check-fullscreen.mjs",
    "check:equalizer": "node scripts/check-equalizer.mjs",
    "check:player-ui": "node scripts/check-home-settings.mjs",
    "check:loading": "node scripts/check-home-settings.mjs --loading",
    "check:stage-performance": "node scripts/check-home-settings.mjs --stage-performance",
    "check:queue-menu": "node scripts/check-queue-menu.mjs",
    "check:storage": "node src-tauri/scripts/check-storage.mjs",
    "check:spectrum": "node scripts/check-spectrum.mjs",
    "check:desktop": "node scripts/check-desktop.mjs",
    "check:tray": "node scripts/check-tray.mjs",
    "check:tray-render": "node scripts/check-tray-render.mjs",
    "check:platform-login": "node scripts/check-platform-login.mjs && node scripts/check-remembered-playback.mjs",
    "check:island-position": "node scripts/check-home-settings.mjs --island-position",
    "check:weather": "node scripts/check-weather.mjs",
    "check:native": "node scripts/check-native.mjs",
    "check:platform-import": "node scripts/check-platform-import.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@iconify/vue": "^5.0.5",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.21.1",
    "pinia": "^4.1.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.22",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  }
}
