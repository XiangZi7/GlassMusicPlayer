{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MiraiPlayer",
  "version": "../package.json",
  "identifier": "com.admin.miraimusic",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "MiraiPlayer",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 620,
        "decorations": false,
        "dragDropEnabled": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "XiangZi",
    "homepage": "https://github.com/XiangZi7/GlassMusicPlayer",
    "category": "Music",
    "shortDescription": "支持同步歌词和桌面小窗的音乐播放器",
    "longDescription": "MiraiPlayer 提供在线曲库搜索、公开歌单导入、逐字歌词、全屏歌词舞台和桌面播放控件。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "startMenuFolder": "MiraiPlayer"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
